@page "/"
@using CodeDeLaRoute.Services
@inject QuestionService QuestionService
@inject NavigationManager Navigation

<PageTitle>Code de la Route - Accueil</PageTitle>

<div class="d-flex flex-column align-center mt-8 mb-4" style="animation: fadeSlideIn 0.6s ease;">
    <MudIcon Icon="@(vehicle == "moto" ? Icons.Material.Filled.TwoWheeler : Icons.Material.Filled.DirectionsCar)"
             Style="font-size: 4rem; color: var(--mud-palette-primary);" />
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mt-2"
             Style="font-weight:900; background: linear-gradient(135deg, #818cf8, #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Code de la Route
    </MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mt-2" Style="max-width:600px; color: var(--mud-palette-text-secondary);">
        Entraînez-vous avec des questions à choix unique et multiple.
        Sélectionnez votre véhicule, une catégorie ou lancez un quiz aléatoire !
    </MudText>
</div>

<MudPaper Class="pa-6 mt-4 mx-auto" MaxWidth="550px" Elevation="3" Style="border-radius:16px;">

    <MudText Typo="Typo.subtitle2" Class="mb-2">🏍️ Type de véhicule</MudText>
    <MudButtonGroup Variant="Variant.Outlined" FullWidth="true" Class="mb-4">
        <MudButton Color="@(vehicle == "auto" ? Color.Primary : Color.Default)"
                   Variant="@(vehicle == "auto" ? Variant.Filled : Variant.Outlined)"
                   OnClick="SwitchToAuto"
                   StartIcon="@Icons.Material.Filled.DirectionsCar"
                   Style="font-weight:600;">
            Auto
        </MudButton>
        <MudButton Color="@(vehicle == "moto" ? Color.Primary : Color.Default)"
                   Variant="@(vehicle == "moto" ? Variant.Filled : Variant.Outlined)"
                   OnClick="SwitchToMoto"
                   StartIcon="@Icons.Material.Filled.TwoWheeler"
                   Style="font-weight:600;">
            Moto
        </MudButton>
    </MudButtonGroup>

    <MudText Typo="Typo.subtitle2" Class="mb-2">📂 Catégorie</MudText>
    <MudChipSet T="string" @bind-SelectedValue="selectedCategory" SelectionMode="SelectionMode.SingleSelection"
                CheckMark="true" Variant="Variant.Outlined" Color="Color.Primary">
        <MudChip Value="@((string?)null)" Text="🎲 Toutes" Default="true" />
        @foreach (var cat in categories)
        {
            <MudChip Value="@cat" Text="@($"{GetCategoryIcon(cat)} {cat}")" />
        }
    </MudChipSet>

    <MudSelect T="int" @bind-Value="questionCount" Label="📊 Nombre de questions" Variant="Variant.Outlined" Class="mt-4">
        <MudSelectItem Value="5">5 questions (rapide)</MudSelectItem>
        <MudSelectItem Value="10">10 questions (standard)</MudSelectItem>
        <MudSelectItem Value="20">20 questions (complet)</MudSelectItem>
        <MudSelectItem Value="40">40 questions (@(vehicle == "moto" ? "ETM" : "examen"))</MudSelectItem>
    </MudSelect>

    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
               Size="Size.Large" Class="mt-6" Style="font-weight:700; font-size:1.1rem;"
               StartIcon="@Icons.Material.Filled.RocketLaunch"
               OnClick="StartQuiz">
        Commencer le Quiz
    </MudButton>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">
        🎯 Simulation d&apos;examen officiel
    </MudText>
    <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
        40 questions · 30 minutes · 20s par question · 35/40 pour réussir
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
               Size="Size.Large" Style="font-weight:700; font-size:1.1rem;"
               StartIcon="@Icons.Material.Filled.School"
               OnClick="StartExam">
        Examen Blanc (@(vehicle == "moto" ? "ETM Moto" : "Auto"))
    </MudButton>

    <MudDivider Class="my-4" />

    <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true"
               OnClick="() => Navigation.NavigateTo(\"/termes\")"
               StartIcon="@Icons.Material.Filled.FindInPage">
        📚 Exercices par termes
    </MudButton>
</MudPaper>

@code {
    private List<string> categories = new();
    private string? selectedCategory;
    private int questionCount = 10;
    private string vehicle = "auto";

    protected override async Task OnInitializedAsync()
    {
        categories = await QuestionService.GetCategoriesAsync(vehicle);
    }

    private async Task SwitchToAuto() => await SwitchVehicle("auto");
    private async Task SwitchToMoto() => await SwitchVehicle("moto");

    private async Task SwitchVehicle(string v)
    {
        vehicle = v;
        selectedCategory = null;
        categories = await QuestionService.GetCategoriesAsync(vehicle);
    }

    private void StartQuiz()
    {
        var catParam = selectedCategory != null ? $"&category={Uri.EscapeDataString(selectedCategory)}" : "";
        Navigation.NavigateTo($"/quiz?count={questionCount}&vehicle={vehicle}{catParam}");
    }

    private void StartExam()
    {
        Navigation.NavigateTo($"/quiz?exam=true&vehicle={vehicle}");
    }

    private string GetCategoryIcon(string category) => category switch
    {
        "Signalisation" => "🚦",
        "Signalisation temporaire" => "🚧",
        "Priorité" => "⚠️",
        "Vitesse" => "⏱️",
        "Alcool et Stupéfiants" => "🍷",
        "Distractions et Fatigue" => "😴",
        "Stationnement" => "🅿️",
        "Éclairage" => "💡",
        "Sécurité" => "🛡️",
        "Croisement et Dépassement" => "↔️",
        "Circulation interfile" => "🏍️",
        "Environnement" => "🌿",
        "Piétons et Cyclistes" => "🚶",
        "Premiers Secours" => "🏥",
        "Permis à Points" => "📝",
        "Conditions Météo" => "🌧️",
        "Conditions météo moto" => "🌧️",
        "Tunnels et Autoroutes" => "🚇",
        "Passages à niveau" => "🚂",
        "Équipement" => "🪖",
        "Maîtrise" => "🎯",
        "Conduite" => "🏍️",
        "Mécanique" => "🔧",
        "Permis" => "📝",
        "Passager" => "🧑‍🤝‍🧑",
        "Chargement et bagages" => "📦",
        "Assurance et documents" => "📄",
        "Documents et Assurance" => "📄",
        _ => "📋"
    };
}

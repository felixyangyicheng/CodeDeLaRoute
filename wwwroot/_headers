# Blazor WebAssembly caching rules for Cloudflare
# Framework files are immutable (fingerprinted in filename)
/_framework/*
  Cache-Control: public, max-age=31536000, immutable

# .NET WASM runtime
/dotnet.js
  Cache-Control: public, max-age=31536000, immutable
/dotnet.native.wasm
  Cache-Control: public, max-age=31536000, immutable
/dotnet.native.js
  Cache-Control: public, max-age=31536000, immutable

# MudBlazor and other static libraries
/_content/*
  Cache-Control: public, max-age=31536000

# Data files (questions JSON)
/data/*
  Cache-Control: public, max-age=3600

# Service worker (short cache for updates)
/service-worker.js
  Cache-Control: public, max-age=300
/service-worker.published.js
  Cache-Control: public, max-age=300

# App shell (short cache, hashed by fingerprint via index.html)
/css/*
  Cache-Control: public, max-age=3600

# PWA manifest and icons
/manifest.json
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400

# HTML — never cache to pick up new deployments
/index.html
  Cache-Control: no-cache

@using MudBlazor

<MudPaper Class="pa-4 d-flex align-center gap-3" Elevation="1" Style="border-radius:12px; height:100%;">
    <MudIcon Icon="@Icon" Color="@Color" Style="font-size:2.25rem; opacity:0.8;" />
    <div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
        <MudText Typo="Typo.h5" Style="font-weight:800; line-height:1.2;">@Value</MudText>
    </div>
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
